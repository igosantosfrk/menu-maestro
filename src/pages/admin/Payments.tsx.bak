import { exportCSV, formatDateBRShort, formatNum } from "@/utils/exportCSV";
import { useState, useEffect, useCallback, type CSSProperties } from 'react';
import { useAuth } from '@/contexts/AuthContext';
import { supabase } from '@/integrations/supabase/client';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Badge } from '@/components/ui/badge';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from '@/components/ui/dialog';
import { toast } from '@/hooks/use-toast';
import DateRangeFilter from '@/components/admin/DateRangeFilter';
import { useDateRange } from '@/hooks/useDateRange';

/* ── design tokens (inline, matching Dashboard) ── */
const T = {
  bg: '#F8F9FC',
  card: '#FFFFFF',
  border: '#E8ECF4',
  text: '#1A1D26',
  muted: '#8892A4',
  pink: '#EC4899',
  blue: '#3B82F6',
  green: '#10B981',
  purple: '#8B5CF6',
  amber: '#F59E0B',
  red: '#EF4444',
  cyan: '#06B6D4',
};

/* ── keyframes injected once ── */
const styleId = 'mm-pay-anim';
if (typeof document !== 'undefined' && !document.getElementById(styleId)) {
  const s = document.createElement('style');
  s.id = styleId;
  s.textContent = `
@keyframes mmPayFadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes mmPayGlow1{0%,100%{transform:translate(0,0)}50%{transform:translate(-30px,30px)}}
@keyframes mmPayGlow2{0%,100%{transform:translate(0,0)}50%{transform:translate(20px,-20px)}}
`;
  document.head.appendChild(s);
}

/* ── SVG Icons (Lucide-style) ── */
const SvgDollar = ({ color = T.green }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
);
const SvgTrending = ({ color = T.green }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
);
const SvgCart = ({ color = T.blue }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
);
const SvgPercent = ({ color = T.purple }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
);
const SvgPackage = ({ color = T.amber }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M16.5 9.4l-9-5.19M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
);
const SvgWallet = ({ color = T.red }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 12V7H5a2 2 0 010-4h14v4"/><path d="M3 5v14a2 2 0 002 2h16v-5"/><path d="M18 12a2 2 0 000 4h4v-4z"/></svg>
);
const SvgPiggy = ({ color = T.blue }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2"/><path d="M2 9.5a1 1 0 113 0"/><path d="M15.7 7.3a1 1 0 11-1.4 1.4"/></svg>
);
const SvgArrowDown = ({ color = T.amber }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="8 12 12 16 16 12"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
);
const SvgArrowUp = ({ color = T.green }: { color?: string }) => (
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="16 12 12 8 8 12"/><line x1="12" y1="16" x2="12" y2="8"/></svg>
);
const SvgArrowDownLg = ({ color = T.red }: { color?: string }) => (
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="8 12 12 16 16 12"/><line x1="12" y1="8" x2="12" y2="16"/></svg>
);
const SvgBarChart = ({ color = T.purple }: { color?: string }) => (
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
);
const SvgReceipt = ({ color = T.pink }: { color?: string }) => (
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1z"/><path d="M16 8h-6a2 2 0 100 4h4a2 2 0 110 4H8"/><path d="M12 17.5V18"/><path d="M12 6v.5"/></svg>
);
const SvgCalculator = ({ color = T.blue }: { color?: string }) => (
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="16" y1="14" x2="16" y2="18"/><line x1="8" y1="11" x2="8" y2="11"/><line x1="12" y1="11" x2="12" y2="11"/><line x1="16" y1="11" x2="16" y2="11"/><line x1="8" y1="15" x2="8" y2="15"/><line x1="12" y1="15" x2="12" y2="15"/><line x1="8" y1="19" x2="8" y2="19"/><line x1="12" y1="19" x2="12" y2="19"/></svg>
);
const SvgPlus = ({ color = '#FFFFFF' }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
);
const SvgTrash = ({ color = T.muted }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
);
const SvgCreditCard = ({ color = T.cyan }: { color?: string }) => (
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
);

const SvgDownload = ({ color = T.muted }: { color?: string }) => (
  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
);

/* ── card base style ── */
const cardBase: CSSProperties = {
  background: T.card,
  border: `1px solid ${T.border}`,
  borderRadius: 14,
  boxShadow: '0 1px 3px rgba(0,0,0,0.04)',
  position: 'relative',
  overflow: 'hidden',
  transition: 'all 0.3s',
};

interface FinancialEntry {
  id: string;
  type: 'income' | 'expense';
  category: string;
  description: string | null;
  amount: number;
  date: string;
  is_recurring: boolean;
}

const expenseCategories = [
  'Aluguel', 'Funcionarios', 'Fornecedores', 'Embalagens', 'Marketing',
  'Manutencao', 'Energia/Agua/Gas', 'Internet/Telefone', 'Impostos',
  'Delivery (apps)', 'Equipamentos', 'Limpeza', 'Outros',
];

const incomeCategories = [
  'Vendas Delivery', 'Vendas Balcao', 'Eventos', 'Outros',
];

const fmt = (v: number) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(v);

const Payments = () => {
  const { tenantId } = useAuth();
  const { preset, setPreset, dateRange, customRange, setCustomRange } = useDateRange('today');
  const [orders, setOrders] = useState<any[]>([]);
  const [entries, setEntries] = useState<FinancialEntry[]>([]);
  const [loading, setLoading] = useState(true);
  const [dialogOpen, setDialogOpen] = useState(false);
  const [newEntry, setNewEntry] = useState({ type: 'expense' as 'income' | 'expense', category: '', description: '', amount: '', date: new Date().toISOString().split('T')[0] });
  const [activeTab, setActiveTab] = useState('dashboard');
  const [mounted, setMounted] = useState(false);

  useEffect(() => { setMounted(true); }, []);

  const fadeUp = (delay: number): CSSProperties => ({
    animation: mounted ? `mmPayFadeUp 0.5s ease ${delay}s both` : 'none',
  });

  const hoverIn = (e: React.MouseEvent<HTMLDivElement>) => {
    (e.currentTarget as HTMLDivElement).style.transform = 'translateY(-2px)';
    (e.currentTarget as HTMLDivElement).style.borderColor = 'rgba(0,0,0,0.06)';
  };
  const hoverOut = (e: React.MouseEvent<HTMLDivElement>) => {
    (e.currentTarget as HTMLDivElement).style.transform = 'translateY(0)';
    (e.currentTarget as HTMLDivElement).style.borderColor = T.border;
  };

  const fetchData = useCallback(async () => {
    if (!tenantId) return;
    setLoading(true);

    const [{ data: ordersData }, { data: entriesData }] = await Promise.all([
      supabase.from('orders').select('total, subtotal, delivery_fee, discount, payment_method, status')
        .eq('tenant_id', tenantId)
        .gte('created_at', dateRange.from.toISOString())
        .lte('created_at', dateRange.to.toISOString()),
      supabase.from('financial_entries').select('*')
        .eq('tenant_id', tenantId)
        .gte('date', dateRange.from.toISOString().split('T')[0])
        .lte('date', dateRange.to.toISOString().split('T')[0])
        .order('date', { ascending: false }),
    ]);

    setOrders((ordersData || []).filter(o => o.status !== 'cancelled'));
    setEntries((entriesData || []) as FinancialEntry[]);
    setLoading(false);
  }, [tenantId, dateRange.from, dateRange.to]);

  useEffect(() => { fetchData(); }, [fetchData]);

  const addEntry = async () => {
    if (!newEntry.category || !newEntry.amount) {
      toast({ title: 'Preencha categoria e valor', variant: 'destructive' }); return;
    }
    const { error } = await supabase.from('financial_entries').insert({
      tenant_id: tenantId, type: newEntry.type, category: newEntry.category,
      description: newEntry.description || null, amount: parseFloat(newEntry.amount), date: newEntry.date,
    });
    if (error) { toast({ title: 'Erro', description: error.message, variant: 'destructive' }); return; }
    toast({ title: 'Lancamento adicionado!' });
    setDialogOpen(false);
    setNewEntry({ type: 'expense', category: '', description: '', amount: '', date: new Date().toISOString().split('T')[0] });
    fetchData();
  };

  const deleteEntry = async (id: string) => {
    await supabase.from('financial_entries').delete().eq('id', id);
    fetchData();
  };

  // Calculations
  const receitaBruta = orders.reduce((s, o) => s + Number(o.total), 0);
  const totalDeliveryFees = orders.reduce((s, o) => s + Number(o.delivery_fee), 0);
  const totalDescontos = orders.reduce((s, o) => s + Number(o.discount || 0), 0);
  const totalPedidos = orders.length;
  const ticketMedio = totalPedidos > 0 ? receitaBruta / totalPedidos : 0;

  const manualIncome = entries.filter(e => e.type === 'income').reduce((s, e) => s + Number(e.amount), 0);
  const manualExpense = entries.filter(e => e.type === 'expense').reduce((s, e) => s + Number(e.amount), 0);

  const totalEntradas = receitaBruta + manualIncome;
  const totalSaidas = manualExpense;
  const lucroReal = totalEntradas - totalSaidas;
  const margem = totalEntradas > 0 ? (lucroReal / totalEntradas) * 100 : 0;

  // Group expenses by category
  const expenseByCategory = entries.filter(e => e.type === 'expense').reduce((acc, e) => {
    acc[e.category] = (acc[e.category] || 0) + Number(e.amount);
    return acc;
  }, {} as Record<string, number>);

  // Payment breakdown
  const paymentBreakdown: Record<string, { count: number; total: number }> = {};
  orders.forEach(o => {
    const m = o.payment_method || 'outros';
    if (!paymentBreakdown[m]) paymentBreakdown[m] = { count: 0, total: 0 };
    paymentBreakdown[m].count++;
    paymentBreakdown[m].total += Number(o.total);
  });
  const methodLabels: Record<string, string> = { pix: 'PIX', credit_card: 'Cartao Credito', debit_card: 'Cartao Debito', cash: 'Dinheiro', online: 'Online' };

  const metricCards = [
    { label: 'Receita Bruta', value: fmt(receitaBruta), icon: <SvgDollar />, iconBg: `rgba(16,185,129,0.1)`, gradient: `linear-gradient(90deg,${T.green},transparent)` },
    { label: 'CMV (Custo Produtos)', value: fmt(0), icon: <SvgPackage />, iconBg: `rgba(245,158,11,0.1)`, gradient: `linear-gradient(90deg,${T.amber},transparent)` },
    { label: 'Custos Operacionais', value: fmt(totalSaidas), icon: <SvgWallet />, iconBg: `rgba(239,68,68,0.08)`, gradient: `linear-gradient(90deg,${T.red},transparent)` },
    { label: 'Lucro Liquido', value: fmt(lucroReal), icon: <SvgTrending color={lucroReal >= 0 ? T.green : T.red} />, iconBg: lucroReal >= 0 ? `rgba(16,185,129,0.1)` : `rgba(239,68,68,0.08)`, gradient: lucroReal >= 0 ? `linear-gradient(90deg,${T.green},transparent)` : `linear-gradient(90deg,${T.red},transparent)` },
    { label: 'Pedidos', value: totalPedidos.toString(), icon: <SvgCart />, iconBg: `rgba(59,130,246,0.1)`, gradient: `linear-gradient(90deg,${T.blue},transparent)` },
    { label: 'Ticket Medio', value: fmt(ticketMedio), icon: <SvgPiggy />, iconBg: `rgba(59,130,246,0.08)`, gradient: `linear-gradient(90deg,${T.blue},transparent)` },
    { label: 'Margem de Lucro', value: `${margem.toFixed(1)}%`, icon: <SvgPercent color={margem >= 0 ? T.purple : T.red} />, iconBg: margem >= 0 ? `rgba(139,92,246,0.08)` : `rgba(239,68,68,0.08)`, gradient: margem >= 0 ? `linear-gradient(90deg,${T.purple},transparent)` : `linear-gradient(90deg,${T.red},transparent)` },
    { label: 'Descontos', value: fmt(totalDescontos), icon: <SvgArrowDown />, iconBg: `rgba(245,158,11,0.1)`, gradient: `linear-gradient(90deg,${T.amber},transparent)` },
  ];

  const tabs = [
    { key: 'dashboard', label: 'Dashboard', icon: <SvgBarChart /> },
    { key: 'income', label: 'Entradas', icon: <SvgArrowUp /> },
    { key: 'expenses', label: 'Saidas', icon: <SvgArrowDownLg /> },
    { key: 'dre', label: 'DRE', icon: <SvgReceipt /> },
  ];

  const EntryForm = () => (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
      <div style={{ display: 'flex', gap: 8 }}>
        <button
          onClick={() => setNewEntry({ ...newEntry, type: 'expense', category: '' })}
          style={{
            padding: '8px 20px', borderRadius: 8, border: 'none', cursor: 'pointer', fontWeight: 600, fontSize: '0.85rem',
            background: newEntry.type === 'expense' ? `linear-gradient(135deg,${T.red},${T.pink})` : 'rgba(0,0,0,0.04)',
            color: newEntry.type === 'expense' ? '#FFFFFF' : T.muted, transition: 'all 0.2s',
          }}
        >Saida</button>
        <button
          onClick={() => setNewEntry({ ...newEntry, type: 'income', category: '' })}
          style={{
            padding: '8px 20px', borderRadius: 8, border: 'none', cursor: 'pointer', fontWeight: 600, fontSize: '0.85rem',
            background: newEntry.type === 'income' ? `linear-gradient(135deg,${T.green},${T.cyan})` : 'rgba(0,0,0,0.04)',
            color: newEntry.type === 'income' ? '#FFFFFF' : T.muted, transition: 'all 0.2s',
          }}
        >Entrada</button>
      </div>
      <div>
        <Label style={{ fontSize: '0.8rem', color: T.muted, fontWeight: 600 }}>Categoria</Label>
        <Select value={newEntry.category} onValueChange={v => setNewEntry({ ...newEntry, category: v })}>
          <SelectTrigger><SelectValue placeholder="Selecione..." /></SelectTrigger>
          <SelectContent>
            {(newEntry.type === 'expense' ? expenseCategories : incomeCategories).map(c => (
              <SelectItem key={c} value={c}>{c}</SelectItem>
            ))}
          </SelectContent>
        </Select>
      </div>
      <div>
        <Label style={{ fontSize: '0.8rem', color: T.muted, fontWeight: 600 }}>Descricao (opcional)</Label>
        <Input value={newEntry.description} onChange={e => setNewEntry({ ...newEntry, description: e.target.value })} placeholder="Ex: Conta de luz marco" />
      </div>
      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
        <div>
          <Label style={{ fontSize: '0.8rem', color: T.muted, fontWeight: 600 }}>Valor (R$)</Label>
          <Input type="number" value={newEntry.amount} onChange={e => setNewEntry({ ...newEntry, amount: e.target.value })} placeholder="0,00" />
        </div>
        <div>
          <Label style={{ fontSize: '0.8rem', color: T.muted, fontWeight: 600 }}>Data</Label>
          <Input type="date" value={newEntry.date} onChange={e => setNewEntry({ ...newEntry, date: e.target.value })} />
        </div>
      </div>
      <button
        onClick={addEntry}
        style={{
          width: '100%', padding: '10px 0', borderRadius: 10, border: 'none', cursor: 'pointer',
          background: `linear-gradient(135deg,${T.blue},${T.purple})`, color: '#FFFFFF',
          fontWeight: 700, fontSize: '0.88rem', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 8,
          transition: 'all 0.2s',
        }}
      >
        <SvgPlus /> Adicionar Lancamento
      </button>
    </div>
  );

  const EntriesTable = ({ type }: { type: 'income' | 'expense' }) => {
    const filtered = entries.filter(e => e.type === type);
    const total = filtered.reduce((s, e) => s + Number(e.amount), 0);
    const isIncome = type === 'income';
    const accent = isIncome ? T.green : T.red;
    return (
      <div style={{ ...fadeUp(0.1) }}>
        {/* Header */}
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 16 }}>
          <div>
            <p style={{ fontSize: '0.8rem', color: T.muted }}>{filtered.length} lancamentos</p>
            <p style={{ fontSize: '1.6rem', fontWeight: 800, letterSpacing: -0.5, color: accent }}>{fmt(total)}</p>
          </div>
          <Dialog open={dialogOpen} onOpenChange={setDialogOpen}>
            <DialogTrigger asChild>
              <button
                onClick={() => { setNewEntry({ ...newEntry, type }); setDialogOpen(true); }}
                style={{
                  padding: '8px 16px', borderRadius: 10, border: 'none', cursor: 'pointer',
                  background: `linear-gradient(135deg,${T.blue},${T.purple})`, color: '#FFFFFF',
                  fontWeight: 600, fontSize: '0.82rem', display: 'flex', alignItems: 'center', gap: 6,
                  transition: 'all 0.2s',
                }}
              >
                <SvgPlus /> Novo
              </button>
            </DialogTrigger>
            <DialogContent>
              <DialogHeader><DialogTitle>Novo Lancamento</DialogTitle></DialogHeader>
              <EntryForm />
            </DialogContent>
          </Dialog>
        </div>
        {filtered.length === 0 ? (
          <div style={{ ...cardBase, padding: '48px 24px', textAlign: 'center', color: T.muted, fontSize: '0.88rem' }}>
            <div style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 2, background: `linear-gradient(90deg,${accent},transparent)` }} />
            Nenhum lancamento no periodo
          </div>
        ) : (
          <div style={{ ...cardBase }}>
            <div style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 2, background: `linear-gradient(90deg,${accent},transparent)` }} />
            <div style={{ overflow: 'auto' }}>
              <table style={{ width: '100%', borderCollapse: 'collapse', fontFamily: "'Inter', sans-serif" }}>
                <thead>
                  <tr>
                    {['Data', 'Categoria', 'Descricao', 'Valor', ''].map((h, i) => (
                      <th key={h || 'action'} style={{
                        padding: '12px 16px', fontSize: '0.7rem', textTransform: 'uppercase' as const, letterSpacing: 1,
                        color: T.muted, fontWeight: 600, textAlign: i === 3 ? 'right' as const : 'left' as const,
                        borderBottom: `1px solid ${T.border}`, background: 'rgba(0,0,0,0.01)', whiteSpace: 'nowrap' as const,
                      }}>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {filtered.map((e, idx) => (
                    <tr key={e.id} style={{ borderBottom: idx < filtered.length - 1 ? `1px solid ${T.border}` : 'none', transition: 'background 0.15s' }}
                      onMouseEnter={ev => { (ev.currentTarget as HTMLTableRowElement).style.background = 'rgba(0,0,0,0.015)'; }}
                      onMouseLeave={ev => { (ev.currentTarget as HTMLTableRowElement).style.background = 'transparent'; }}
                    >
                      <td style={{ padding: '12px 16px', fontSize: '0.85rem', color: T.text, whiteSpace: 'nowrap' as const }}>
                        {new Date(e.date + 'T12:00:00').toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' })}
                      </td>
                      <td style={{ padding: '12px 16px' }}>
                        <span style={{
                          fontSize: '0.75rem', fontWeight: 600, padding: '3px 10px', borderRadius: 6,
                          background: isIncome ? 'rgba(16,185,129,0.08)' : 'rgba(239,68,68,0.06)',
                          color: isIncome ? T.green : T.red, whiteSpace: 'nowrap' as const,
                        }}>{e.category}</span>
                      </td>
                      <td style={{ padding: '12px 16px', fontSize: '0.83rem', color: T.muted }}>{e.description || '\u2014'}</td>
                      <td style={{ padding: '12px 16px', fontSize: '0.88rem', fontWeight: 700, color: accent, textAlign: 'right' as const, whiteSpace: 'nowrap' as const }}>{fmt(e.amount)}</td>
                      <td style={{ padding: '12px 16px', width: 40 }}>
                        <button
                          onClick={() => deleteEntry(e.id)}
                          style={{ background: 'none', border: 'none', cursor: 'pointer', padding: 4, borderRadius: 6, transition: 'all 0.2s', display: 'flex', alignItems: 'center', justifyContent: 'center' }}
                          onMouseEnter={ev => { (ev.currentTarget as HTMLButtonElement).style.background = 'rgba(239,68,68,0.08)'; }}
                          onMouseLeave={ev => { (ev.currentTarget as HTMLButtonElement).style.background = 'none'; }}
                        >
                          <SvgTrash color={T.muted} />
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    );
  };

  return (
    <div style={{ fontFamily: "'Inter', sans-serif", color: T.text, position: 'relative', minHeight: '100%' }}>
      {/* Background decorations */}
      <div style={{ position: 'fixed', top: 0, left: 0, width: '100%', height: '100%', backgroundImage: `linear-gradient(rgba(59,130,246,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(59,130,246,0.04) 1px,transparent 1px)`, backgroundSize: '80px 80px', pointerEvents: 'none' as const, zIndex: 0 }} />
      <div style={{ position: 'fixed', top: -200, right: -150, width: 600, height: 600, background: 'radial-gradient(circle,rgba(16,185,129,0.06) 0%,transparent 70%)', pointerEvents: 'none' as const, zIndex: 0, animation: 'mmPayGlow1 8s ease-in-out infinite' }} />
      <div style={{ position: 'fixed', bottom: -200, left: -150, width: 500, height: 500, background: 'radial-gradient(circle,rgba(139,92,246,0.04) 0%,transparent 70%)', pointerEvents: 'none' as const, zIndex: 0, animation: 'mmPayGlow2 10s ease-in-out infinite' }} />

      <div style={{ position: 'relative', zIndex: 1, padding: '0 0 40px 0' }}>
        {/* Header */}
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 28, flexWrap: 'wrap' as const, gap: 16 }}>
          <div>
            <h1 style={{ fontSize: '1.6rem', fontWeight: 800, letterSpacing: -0.5, marginBottom: 4, ...fadeUp(0) }}>
              <span style={{ background: `linear-gradient(135deg,${T.green},${T.blue})`, WebkitBackgroundClip: 'text', WebkitTextFillColor: 'transparent' }}>Financeiro</span>
            </h1>
            <p style={{ fontSize: '0.88rem', color: T.muted, ...fadeUp(0.05) }}>Controle de receitas, despesas e resultados</p>
          </div>
          <div style={{ display: 'flex', alignItems: 'center', gap: 10, ...fadeUp(0.1) }}>
            <button
              onClick={() => {
                exportCSV(entries, 'financeiro.csv', [
                  { key: 'date', label: 'Data', format: (v: any) => formatDateBRShort(v) },
                  { key: 'type', label: 'Tipo', format: (v: any) => v === 'income' ? 'Receita' : 'Despesa' },
                  { key: 'category', label: 'Categoria' },
                  { key: 'description', label: 'Descricao' },
                  { key: 'amount', label: 'Valor', format: (v: any) => formatNum(v) },
                  { key: 'is_recurring', label: 'Recorrente', format: (v: any) => v ? 'Sim' : 'Nao' },
                ]);
              }}
              title="Exportar CSV"
              style={{
                display: 'inline-flex', alignItems: 'center', gap: 6,
                padding: '7px 14px', borderRadius: 10,
                background: T.card, color: T.text, fontWeight: 500, fontSize: '0.78rem',
                border: `1px solid ${T.border}`, cursor: 'pointer',
                transition: 'all 0.2s', boxShadow: '0 1px 3px rgba(0,0,0,0.04)',
              }}
              onMouseEnter={e => { (e.currentTarget as HTMLButtonElement).style.transform = 'translateY(-1px)'; }}
              onMouseLeave={e => { (e.currentTarget as HTMLButtonElement).style.transform = 'translateY(0)'; }}
            >
              <SvgDownload /> Exportar
            </button>
            <DateRangeFilter preset={preset} onPresetChange={setPreset} customRange={customRange} onCustomRangeChange={setCustomRange} />
          </div>
        </div>

        {/* Tabs */}
        <div style={{ display: 'flex', gap: 4, marginBottom: 24, background: 'rgba(0,0,0,0.02)', borderRadius: 12, padding: 4, border: `1px solid ${T.border}`, ...fadeUp(0.1) }}>
          {tabs.map(t => (
            <button
              key={t.key}
              onClick={() => setActiveTab(t.key)}
              style={{
                display: 'flex', alignItems: 'center', gap: 6, padding: '8px 16px', borderRadius: 8,
                border: 'none', cursor: 'pointer', fontSize: '0.82rem', fontWeight: 600,
                background: activeTab === t.key ? T.card : 'transparent',
                color: activeTab === t.key ? T.text : T.muted,
                boxShadow: activeTab === t.key ? '0 1px 3px rgba(0,0,0,0.06)' : 'none',
                transition: 'all 0.2s',
              }}
            >
              {t.icon} {t.label}
            </button>
          ))}
        </div>

        {/* DASHBOARD TAB */}
        {activeTab === 'dashboard' && (
          <div>
            {/* Metric Cards */}
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 12, marginBottom: 16 }}>
              {metricCards.map((c, i) => (
                <div
                  key={c.label}
                  style={{ ...cardBase, padding: '20px 18px', ...fadeUp(0.15 + i * 0.04) }}
                  onMouseEnter={hoverIn}
                  onMouseLeave={hoverOut}
                >
                  <div style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 2, background: c.gradient }} />
                  <div style={{ position: 'absolute', bottom: 0, left: 0, right: 0, height: 1, background: 'linear-gradient(90deg,transparent,rgba(139,92,246,0.08),transparent)' }} />
                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10 }}>
                    <span style={{ fontSize: '0.62rem', textTransform: 'uppercase' as const, letterSpacing: 1.2, color: T.muted, fontWeight: 600 }}>{c.label}</span>
                    <div style={{ width: 28, height: 28, borderRadius: 8, display: 'flex', alignItems: 'center', justifyContent: 'center', background: c.iconBg }}>
                      {c.icon}
                    </div>
                  </div>
                  <div style={{ fontSize: '1.5rem', fontWeight: 800, letterSpacing: -1 }}>{c.value}</div>
                </div>
              ))}
            </div>

            {/* Summary Cards (3-col) */}
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 12, marginBottom: 16 }}>
              {[
                { label: 'Total Entradas', value: fmt(totalEntradas), icon: <SvgArrowUp color={T.green} />, color: T.green, gradient: `linear-gradient(90deg,${T.green},transparent)` },
                { label: 'Total Saidas', value: fmt(totalSaidas), icon: <SvgArrowDownLg color={T.red} />, color: T.red, gradient: `linear-gradient(90deg,${T.red},transparent)` },
                { label: 'Lucro Real', value: fmt(lucroReal), icon: <SvgTrending color={lucroReal >= 0 ? T.green : T.red} />, color: lucroReal >= 0 ? T.green : T.red, gradient: lucroReal >= 0 ? `linear-gradient(90deg,${T.green},transparent)` : `linear-gradient(90deg,${T.red},transparent)` },
              ].map((c, i) => (
                <div
                  key={c.label}
                  style={{ ...cardBase, padding: '20px 18px', ...fadeUp(0.5 + i * 0.05) }}
                  onMouseEnter={hoverIn}
                  onMouseLeave={hoverOut}
                >
                  <div style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 2, background: c.gradient }} />
                  <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 8 }}>
                    {c.icon}
                    <span style={{ fontSize: '0.72rem', color: T.muted, fontWeight: 600 }}>{c.label}</span>
                  </div>
                  <p style={{ fontSize: '1.7rem', fontWeight: 800, letterSpacing: -0.5, color: c.color }}>{c.value}</p>
                </div>
              ))}
            </div>

            {/* Payment Breakdown */}
            <div style={{ ...cardBase, borderRadius: 16, padding: 24, ...fadeUp(0.65) }}>
              <div style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 2, background: `linear-gradient(90deg,${T.cyan},transparent)` }} />
              <div style={{ fontSize: '0.95rem', fontWeight: 700, marginBottom: 4, display: 'flex', alignItems: 'center', gap: 8 }}>
                <SvgCreditCard /> Receita por Forma de Pagamento
              </div>
              <div style={{ fontSize: '0.75rem', color: T.muted, marginBottom: 20 }}>Distribuicao por metodo de pagamento no periodo</div>
              {Object.keys(paymentBreakdown).length === 0 ? (
                <div style={{ textAlign: 'center' as const, padding: '40px 0', color: T.muted, fontSize: '0.85rem' }}>
                  Nenhum pedido no periodo
                </div>
              ) : (
                <div style={{ overflow: 'auto' }}>
                  <table style={{ width: '100%', borderCollapse: 'collapse', fontFamily: "'Inter', sans-serif" }}>
                    <thead>
                      <tr>
                        {['Metodo', 'Pedidos', 'Total', '%'].map((h, i) => (
                          <th key={h} style={{
                            padding: '10px 16px', fontSize: '0.7rem', textTransform: 'uppercase' as const, letterSpacing: 1,
                            color: T.muted, fontWeight: 600, textAlign: i === 0 ? 'left' as const : 'right' as const,
                            borderBottom: `1px solid ${T.border}`, background: 'rgba(0,0,0,0.01)',
                          }}>{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {Object.entries(paymentBreakdown).sort((a, b) => b[1].total - a[1].total).map(([m, v], idx, arr) => (
                        <tr key={m}
                          style={{ borderBottom: idx < arr.length - 1 ? `1px solid ${T.border}` : 'none', transition: 'background 0.15s' }}
                          onMouseEnter={ev => { (ev.currentTarget as HTMLTableRowElement).style.background = 'rgba(0,0,0,0.015)'; }}
                          onMouseLeave={ev => { (ev.currentTarget as HTMLTableRowElement).style.background = 'transparent'; }}
                        >
                          <td style={{ padding: '12px 16px', fontSize: '0.88rem', fontWeight: 600 }}>{methodLabels[m] || m}</td>
                          <td style={{ padding: '12px 16px', fontSize: '0.85rem', textAlign: 'right' as const, color: T.muted }}>{v.count}</td>
                          <td style={{ padding: '12px 16px', fontSize: '0.88rem', textAlign: 'right' as const, fontWeight: 700, color: T.blue }}>{fmt(v.total)}</td>
                          <td style={{ padding: '12px 16px', fontSize: '0.85rem', textAlign: 'right' as const, color: T.muted }}>
                            {receitaBruta > 0 ? ((v.total / receitaBruta) * 100).toFixed(1) : '0.0'}%
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        )}

        {/* INCOME TAB */}
        {activeTab === 'income' && <EntriesTable type="income" />}

        {/* EXPENSES TAB */}
        {activeTab === 'expenses' && <EntriesTable type="expense" />}

        {/* DRE TAB */}
        {activeTab === 'dre' && (
          <div style={{ ...cardBase, borderRadius: 16, padding: 28, ...fadeUp(0.1) }}>
            <div style={{ position: 'absolute', top: 0, left: 0, right: 0, height: 2, background: `linear-gradient(90deg,${T.blue},${T.purple})` }} />
            {/* Title */}
            <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 24 }}>
              <div style={{ width: 36, height: 36, borderRadius: 10, display: 'flex', alignItems: 'center', justifyContent: 'center', background: `rgba(59,130,246,0.1)` }}>
                <SvgCalculator />
              </div>
              <div>
                <p style={{ fontSize: '1.05rem', fontWeight: 700 }}>Demonstrativo de Resultado (DRE)</p>
                <p style={{ fontSize: '0.75rem', color: T.muted }}>Resumo financeiro do periodo selecionado</p>
              </div>
            </div>

            {/* DRE Lines */}
            <div style={{ display: 'flex', flexDirection: 'column' as const, gap: 2 }}>
              {/* Receita Bruta */}
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '12px 12px', borderBottom: `1px solid ${T.border}`, borderRadius: 6 }}>
                <span style={{ fontWeight: 700, fontSize: '0.92rem' }}>Receita Bruta de Vendas</span>
                <span style={{ fontWeight: 800, color: T.green, fontSize: '0.92rem' }}>{fmt(receitaBruta)}</span>
              </div>
              {/* Descontos */}
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '8px 12px 8px 32px', fontSize: '0.85rem', color: T.muted }}>
                <span>(-) Descontos concedidos</span>
                <span style={{ color: T.red }}>- {fmt(totalDescontos)}</span>
              </div>
              {/* Outras receitas */}
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '8px 12px 8px 32px', fontSize: '0.85rem', color: T.muted }}>
                <span>(+) Outras receitas</span>
                <span style={{ color: T.green }}>+ {fmt(manualIncome)}</span>
              </div>
              {/* Receita Liquida */}
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '12px 12px', margin: '4px 0', borderRadius: 8, background: 'rgba(0,0,0,0.02)', border: `1px solid ${T.border}` }}>
                <span style={{ fontWeight: 700, fontSize: '0.92rem' }}>Receita Liquida</span>
                <span style={{ fontWeight: 800, fontSize: '0.92rem' }}>{fmt(receitaBruta - totalDescontos + manualIncome)}</span>
              </div>

              <div style={{ height: 12 }} />

              {/* Delivery fees */}
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '8px 12px 8px 32px', fontSize: '0.85rem', color: T.muted }}>
                <span>(-) Taxas de entrega (custo)</span>
                <span style={{ color: T.red }}>- {fmt(totalDeliveryFees)}</span>
              </div>

              {/* Expense categories */}
              {Object.entries(expenseByCategory).sort((a, b) => b[1] - a[1]).map(([cat, val]) => (
                <div key={cat} style={{ display: 'flex', justifyContent: 'space-between', padding: '8px 12px 8px 32px', fontSize: '0.85rem', color: T.muted }}>
                  <span>(-) {cat}</span>
                  <span style={{ color: T.red }}>- {fmt(val)}</span>
                </div>
              ))}

              {/* Total despesas */}
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '12px 12px', margin: '4px 0', borderRadius: 8, background: 'rgba(0,0,0,0.02)', border: `1px solid ${T.border}` }}>
                <span style={{ fontWeight: 700, fontSize: '0.92rem' }}>Total Despesas Operacionais</span>
                <span style={{ fontWeight: 800, color: T.red, fontSize: '0.92rem' }}>- {fmt(totalSaidas + totalDeliveryFees)}</span>
              </div>

              <div style={{ height: 12 }} />

              {/* Resultado final */}
              <div style={{
                display: 'flex', justifyContent: 'space-between', padding: '16px 16px', borderRadius: 12,
                background: lucroReal >= 0
                  ? `linear-gradient(135deg, rgba(16,185,129,0.06), rgba(16,185,129,0.12))`
                  : `linear-gradient(135deg, rgba(239,68,68,0.06), rgba(239,68,68,0.12))`,
                border: `2px solid ${lucroReal >= 0 ? 'rgba(16,185,129,0.25)' : 'rgba(239,68,68,0.25)'}`,
              }}>
                <span style={{ fontWeight: 800, fontSize: '1.1rem' }}>RESULTADO LIQUIDO</span>
                <span style={{ fontWeight: 800, fontSize: '1.2rem', color: lucroReal >= 0 ? T.green : T.red }}>
                  {fmt(receitaBruta - totalDescontos + manualIncome - totalSaidas - totalDeliveryFees)}
                </span>
              </div>

              {/* Margem */}
              {totalEntradas > 0 && (
                <div style={{ display: 'flex', justifyContent: 'space-between', padding: '10px 12px', fontSize: '0.88rem' }}>
                  <span style={{ color: T.muted }}>Margem de Lucro</span>
                  <span style={{ fontWeight: 700, color: margem >= 0 ? T.green : T.red }}>{margem.toFixed(1)}%</span>
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default Payments;
